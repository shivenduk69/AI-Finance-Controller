# ====================================================================
# AI Finance Controller — AI & Data Processing Service Environment Template (Local)
# ====================================================================

PORT=8000
ENVIRONMENT=development

# Internal Service-to-Service Security
INTERNAL_API_SECRET=finance_controller_internal_secret_key_2026

# PostgreSQL Connection (Scoped to finance_ai_user)
DB_HOST=localhost
DB_PORT=5434
DB_NAME=finance_controller
DB_USER=finance_ai_user
DB_PASSWORD=ai_secure_password

# Google Gemini Configuration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
EMBEDDING_MODEL=models/text-embedding-004

# Redis Connection
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=redis_secure_password

# RabbitMQ Connection
RABBITMQ_URL=amqp://finance_admin:rabbitmq_secure_password@localhost:5672
