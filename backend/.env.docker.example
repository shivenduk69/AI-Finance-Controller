# ====================================================================
# AI Finance Controller — Backend Service Docker Environment Template
# ====================================================================

PORT=5000
NODE_ENV=production

# PostgreSQL Connection (Internal finance-network DNS)
DB_HOST=finance-postgres
DB_PORT=5432
DB_NAME=finance_controller
DB_USER=finance_backend_user
DB_PASSWORD=backend_secure_password

# Redis Connection (Internal finance-network DNS)
REDIS_HOST=finance-redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_secure_password

# RabbitMQ Connection (Internal finance-network DNS)
RABBITMQ_URL=amqp://finance_admin:rabbitmq_secure_password@finance-rabbitmq:5672

# AI Service Endpoint & Shared Secret
AI_SERVICE_URL=http://finance-ai-service:8000
INTERNAL_API_SECRET=finance_controller_internal_secret_key_2026

# JWT Authentication
JWT_SECRET=finance_controller_jwt_super_secret_key_production_grade_2026
JWT_EXPIRES_IN=7d

# CORS Origin
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
