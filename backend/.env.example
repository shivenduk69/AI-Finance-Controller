# ====================================================================
# AI Finance Controller — Backend Service Environment Template (Local)
# ====================================================================

PORT=5000
NODE_ENV=development

# PostgreSQL Connection (Scoped to finance_backend_user)
DB_HOST=localhost
DB_PORT=5434
DB_NAME=finance_controller
DB_USER=finance_backend_user
DB_PASSWORD=backend_secure_password

# Redis Connection
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=redis_secure_password

# RabbitMQ Connection
RABBITMQ_URL=amqp://finance_admin:rabbitmq_secure_password@localhost:5672

# AI Service Endpoint & Shared Secret
AI_SERVICE_URL=http://localhost:8000
INTERNAL_API_SECRET=finance_controller_internal_secret_key_2026

# JWT Authentication
JWT_SECRET=finance_controller_jwt_super_secret_key_production_grade_2026
JWT_EXPIRES_IN=7d

# CORS Origin (Frontend URL)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
